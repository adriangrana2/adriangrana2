---
// Load the shared stylesheet and site header
import '../styles/global.css';
import Header from '../components/Header.astro';

// Import the default language and the permitted language type.
import { defaultLocale, type Locale } from '../i18n';

// Describe the properties supplied by each page.
interface Props {
  title: string;
  description: string;
  lang?: Locale;
  languageUrls: Record<Locale, string>;
}

// Use the default language when a page does not supply one.
const { 
  title, 
  description, 
  lang = defaultLocale,
  languageUrls,
  } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Shared browser settings and page-specific metadata. -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <!-- Display the shared identity and language controls. -->
    <Header lang={lang} languageUrls={languageUrls} />
    <!-- Insert the content supplied by each page. -->
    <main>
      <slot />
    </main>
  </body>
</html>