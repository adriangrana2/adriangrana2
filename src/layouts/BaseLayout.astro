---
// Load the shared stylesheet.
import '../styles/global.css';

// Import the default language and the permitted language type.
import { defaultLocale, type Locale } from '../i18n';

// Define the information each page can provide.
interface Props {
  title: string;
  description: string;
  lang?: Locale;
}

// Use the default language when a page does not supply one.
const { title, description, lang = defaultLocale } = Astro.props;
---

<!doctype html>
<html lang="lang">
  <head>
    <!-- Shared browser settings and page-specific metadata. -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <!-- Insert the content supplied by each page. -->
    <main>
      <slot />
    </main>
  </body>
</html>