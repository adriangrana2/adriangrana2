---
// Read the default language from the shared configuration.
import { defaultLocale } from '../i18n';

// Remove a trailing slash so the destination has no doubled slashes.
// BASE_URL reflects the base configured in astro.config.mjs.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

// Redirect visitors to the default-language homepage.
return Astro.redirect(`${basePath}/${defaultLocale}/`);
---