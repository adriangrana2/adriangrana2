---
// Import the shared layout and language settings.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n';
import { homeText } from '../../i18n/home';

// Tell Astro to generate one static page for each supported language.
export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

// Describe the language property supplied by getStaticPaths().
interface Props {
  lang: Locale;
}

// Select the text matching this page's language.
const { lang } = Astro.props;
const text = homeText[lang];

// Respect the URL prefix configured in Astro.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

// Supply the equivalent homepage URL for every language.
const languageUrls: Record<Locale, string> = {
  de: `${basePath}/de/`,
  en: `${basePath}/en/`,
  es: `${basePath}/es/`,
};
---

<BaseLayout
  title="Adrian Granados"
  description={text.description}
  lang={lang}
  languageUrls={languageUrls}
>
  <!-- Use the same structure with translated content. -->
  <section aria-labelledby="hero-title">
    <p>{text.role}</p>

    <h1 id="hero-title">Adrian Granados</h1>

    <p class="hero__focus">{text.focus}</p>

    <p class="hero__interests">
      <strong>{text.interestsLabel}</strong>
      {text.interests}
    </p>

    <p>{text.introduction}</p>
  </section>
</BaseLayout>